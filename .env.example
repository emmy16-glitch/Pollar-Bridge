PORT=4000
MODE=sandbox
# Pollar: publishable goes to the @pollar/react frontend, secret stays HERE.
# Get both at https://dashboard.pollar.xyz -> Build -> API Keys. Start testnet.
POLLAR_ENV=testnet
POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
POLLAR_API_KEY=
# Provider credential keys (names only in config; values in env/secrets manager)
NG_BANK_SANDBOX_API_KEY=
NG_BANK_LIVE_API_KEY=
GH_MOBILE_SANDBOX_API_KEY=
GH_MOBILE_LIVE_API_KEY=
