PORT=4000
MODE=sandbox
# Pollar: publishable goes to the @pollar/react frontend, secret stays HERE.
# Get both at https://dashboard.pollar.xyz -> Build -> API Keys. Start testnet.
POLLAR_ENV=testnet
POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
POLLAR_API_KEY=
# Provider credential keys (names only in config; values in env/secrets manager)
NG_BANK_SANDBOX_API_KEY=
NG_BANK_LIVE_API_KEY=
GH_MOBILE_SANDBOX_API_KEY=
GH_MOBILE_LIVE_API_KEY=
# Operator gate: when set, money-moving routes require x-operator-key header
# (POST /operator/*, POST /transfers/:id/settle, PATCH /corridors/:id).
# Leave empty for local demo; ALWAYS set in pilot/live.
OPERATOR_API_KEY=
# Webhooks (live mode): HMAC-SHA256 shared secret for provider callbacks.
# Signed payload is "<timestamp>.<raw-body>", headers x-webhook-signature + x-webhook-timestamp.
WEBHOOK_SECRET=
# x402 machine rail: escrow address machines pay into before redeeming a memo.
# Empty = the visibly-fake "G-AGENT-ESCROW-sandbox" (demo mode).
AGENT_SETTLE_WALLET=
# CORS allowlist (comma-separated origins). Empty = allow all (dev only)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
