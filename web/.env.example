# Copy to .env.local. Secrets stay HERE — never commit this file.
# The portal's /api/* routes are thin proxies to the Express backend, so no
# Postgres is required at runtime. drizzle/pg remain only for legacy types.

# Express backend base URL (backend serves /api/* on :4000).
BACKEND_URL=http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Must match the backend's OPERATOR_API_KEY when it is set. Money-moving
# proxy calls (verify/settle/reject, corridor toggles) forward it as
# x-operator-key. Leave empty for local demo.
OPERATOR_API_KEY=
